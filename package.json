{
  "name": "cloud-agent-bridge",
  "version": "0.1.2",
  "description": "Authenticate coding-agent CLIs inside cloud agent sessions and delegate tasks to them.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "agents",
    "cli",
    "delegation",
    "cloud"
  ],
  "homepage": "https://github.com/Dasannn/Agent-Bridge#readme",
  "bugs": {
    "url": "https://github.com/Dasannn/Agent-Bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dasannn/Agent-Bridge.git"
  },
  "license": "MIT",
  "author": "Dasannn",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-bridge": "dist/cli/bin.js",
    "bridge": "dist/cli/bin.js"
  },
  "files": [
    "dist/adapters",
    "dist/cli",
    "dist/core",
    "skill"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p . && node dist/tools/sync-skill.js",
    "prepare": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@xterm/headless": "6.0.0"
  }
}
